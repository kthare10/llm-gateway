# LLM Gateway Configuration
# Copy this file to .env and fill in the values

# ---- Domain ----
GATEWAY_FQDN=llm-gateway.example.com

# ---- Authentication Provider ----
# "github" (default) or "cilogon"
AUTH_PROVIDER=github

# ---- CILogon OIDC (required when AUTH_PROVIDER=cilogon) ----
# Register at https://cilogon.org/oauth2/register
CILOGON_CLIENT_ID=cilogon:/client_id/xxxxxxxx
CILOGON_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxx

# ---- GitHub OAuth (required when AUTH_PROVIDER=github) ----
# Register at https://github.com/settings/applications/new
# Set Authorization callback URL to: https://<your-FQDN>/auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Vouch Proxy ----
# Random string >= 44 characters for JWT signing
# Generate with: openssl rand -base64 33
VOUCH_JWT_SECRET=

# ---- LiteLLM ----
LITELLM_MASTER_KEY=sk-change-me-to-a-random-string
LITELLM_POSTGRES_PASSWORD=litellm_secret_password
LITELLM_UI_USERNAME=admin
LITELLM_UI_PASSWORD=change-me

# ---- Gateway API Database ----
GATEWAY_DB_PASSWORD=gateway_secret_password

# ---- LLM Backend Keys (add as needed) ----
# AZURE_API_KEY=your-azure-key
# OPENAI_API_KEY=your-openai-key
